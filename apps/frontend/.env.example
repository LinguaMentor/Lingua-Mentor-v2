# Empty means the API is on the same origin as the page, by relative path. Staging and production images
# are built that way, so leave them empty for any deployed build.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_VOICE_URL=
# Local dev — api-gateway runs on :3000 (see apps/api-gateway/.env.example),
# this app runs on :3001 (see the `dev` script) so the two never collide.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
