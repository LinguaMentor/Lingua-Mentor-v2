DATABASE_URL=postgresql://user:pass@host/db   # Neon connection string, asyncpg driver
REDIS_URL=redis://localhost:6379
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem     # verify-only — this service never issues tokens
APP_ENV=development                            # development | test | staging | production
LLM_PROVIDER=fake                              # fake: fixed replies, no key or network; groq needs GROQ_API_KEY
GROQ_API_KEY=
ELEVENLABS_API_KEY=                            # Phase 2, unused until then
# Error reports to Bugsink; empty sends nothing. SENTRY_RELEASE comes from the image.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
