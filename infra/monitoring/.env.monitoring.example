# Copy to .env.monitoring next to setup.sh and fill it in. That file holds secrets and is git-ignored.

# The Cloudflare domain without a subdomain. Bugsink is served at errors.<DOMAIN>.
DOMAIN=

# The monitoring tunnel (its own tunnel, not staging's) and its credentials JSON.
TUNNEL_ID=
TUNNEL_CREDENTIALS_FILE=

# The subnet the app servers sit in, as shown in the Oracle console, e.g. 10.0.1.0/24.
APP_SUBNET_CIDR=

# Optional email (STARTTLS on port 587). Leave all four empty to send alerts to a chat webhook only.
# The From address must be on a domain the provider has verified.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The R2 bucket for backups and an API token limited to it (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
