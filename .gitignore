# --- dependencies ---
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/

# --- build output ---
.next/
# Generated by `next typegen`, `next dev` and `next build`, in a different form each time.
next-env.d.ts
dist/
build/
*.egg-info/

# --- env & secrets ---
# Matches .env, .env.local, .env.production, .env.development, .env.<anything> —
# then explicitly un-ignores the committed template files.
.env
.env.*
!.env.example
*.pem
*.key
!*.example

# --- logs ---
*.log
npm-debug.log*

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- test / coverage ---
coverage/
.pytest_cache/
htmlcov/

# --- misc ---
.turbo/
*.tsbuildinfo

# --- local working notes ---
ENGINEERING_REVIEW.md
PRODUCT_RESEARCH.md
CLAUDE.md

# --- product documents: kept private, the repo is public ---
docs/prd/*.docx
docs/prd/*.pdf
